<!doctype html>
<html lang="en">
  {{ template "head" . }}
  <body class="flex min-h-screen flex-col">
    {{ template "header" . }}

    <main class="page-shell">
      <div class="mx-auto w-full max-w-3xl">
        <div class="flex items-end justify-between gap-4">
          <div>
            <h1 class="page-title">Search results</h1>
            <p class="mt-2 text-sm text-[#777974]">
              About {{ formatNumber .total }} matching pages
            </p>
          </div>
          <a href="/" class="text-link shrink-0 text-sm">New search</a>
        </div>

        {{ if .locations }}
        <section class="mt-8 border-t border-[#e2e0da] pt-6">
          <p class="mb-4 text-sm text-[#777974]">
            Page {{ .currentPage }} of {{ formatNumber .totalPages }}
          </p>

          <div class="overflow-hidden rounded-md border border-[#deddd7] bg-white divide-y divide-[#eceae5]">
            {{ range .locations }}
            <form action="/browse" method="POST">
              <input type="hidden" name="location" value="{{ .String }}" />
              <input type="hidden" name="query" value="{{ $.query }}" />
              <button type="submit" class="location-link" title="{{ .String }}">
                {{ .String }}
              </button>
            </form>
            {{ end }}
          </div>

          {{ template "paginationControls" . }}
        </section>
        {{ else }}
        <p class="mt-8 border-t border-[#e2e0da] pt-6 text-[#777974]">
          No matching pages were found.
        </p>
        {{ end }}
      </div>
    </main>

    {{ template "footer" . }}
  </body>
</html>
