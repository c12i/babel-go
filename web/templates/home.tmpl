<!doctype html>
<html lang="en">
  {{ template "head" . }}
  <body class="flex h-dvh flex-col overflow-hidden">
    {{ template "header" . }}

    <main class="home-shell">
      <div class="mx-auto max-w-2xl">
        <section class="mb-6 sm:mb-8">
          <h1 class="display-title">Every page that could ever be written.</h1>
          <p class="mt-6 max-w-xl text-base leading-7 text-[#656762] sm:text-lg">
            The Library of Babel contains every possible 3,200-character page.
            Enter a passage to find where it lives.
          </p>
        </section>

        <form action="/search" method="POST">
          {{ if .error }}{{ template "errorAlert" . }}{{ end }}
          <label for="text" class="field-label">Text to find</label>
          <textarea
            name="text"
            id="text"
            rows="4"
            maxlength="3200"
            placeholder="Write or paste any text"
            class="text-field resize-y"
            autofocus
          >{{ .query }}</textarea>
          <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-sm text-[#858782]">Up to 3,200 characters</p>
            <button type="submit" class="primary-button">Find this text</button>
          </div>
        </form>

        <aside class="mt-6 border-t border-[#e2e0da] pt-4 text-sm leading-6 text-[#777974] sm:mt-8 sm:pt-5">
          <p>
            Pages use the letters a-z, spaces, commas, and periods. Each book has
            410 pages and a unique address in the library.
          </p>
          <p class="mt-3 font-serif italic">
            Inspired by Jorge Luis Borges's short story
            <a
              href="https://en.wikipedia.org/wiki/The_Library_of_Babel"
              target="_blank"
              rel="noopener"
              class="text-link"
            >"The Library of Babel."</a>
          </p>
        </aside>
      </div>
    </main>

    {{ template "footer" . }}
  </body>
</html>
