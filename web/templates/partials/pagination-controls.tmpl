{{ define "paginationControls" }}
<div class="flex flex-wrap items-center justify-center gap-3 pt-6">
  <form action="/search" method="POST">
    <input type="hidden" name="text" value="{{ .query }}" />
    <input type="hidden" name="page" value="{{ sub .currentPage 1 }}" />
    <button type="submit" {{ if not .hasPrev }}disabled{{ end }} class="secondary-button" aria-label="Previous page">
      &larr; Previous
    </button>
  </form>

  <form action="/search" method="POST" class="flex items-center gap-2">
    <input type="hidden" name="text" value="{{ .query }}" />
    <input
      type="number"
      name="page"
      min="1"
      max="{{ .totalPages }}"
      placeholder="{{ .currentPage }}"
      aria-label="Page number"
      class="text-field w-16 px-2 py-2 text-center text-sm"
    />
    <span class="text-sm text-[#777974]">of {{ formatNumber .totalPages }}</span>
    <button type="submit" class="secondary-button px-3">Go</button>
  </form>

  <form action="/search" method="POST">
    <input type="hidden" name="text" value="{{ .query }}" />
    <input type="hidden" name="page" value="{{ add .currentPage 1 }}" />
    <button type="submit" {{ if not .hasNext }}disabled{{ end }} class="secondary-button" aria-label="Next page">
      Next &rarr;
    </button>
  </form>
</div>
{{ end }}
