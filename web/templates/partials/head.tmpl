{{ define "head" }}
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta
    name="description"
    content="Search and browse an infinite library containing every possible page."
  />
  <title>{{ .title }} - Library of Babel</title>
  <link rel="icon" type="image/svg+xml" href="/static/favicon.svg" />
  <script src="https://cdn.tailwindcss.com"></script>

  <style type="text/tailwindcss">
    @layer base {
      :root {
        color-scheme: light;
      }

      body {
        @apply min-h-screen bg-[#faf9f6] text-[#292b28] antialiased;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;
      }

      ::selection {
        @apply bg-[#dedede] text-[#202020];
      }

      button,
      input,
      textarea {
        font: inherit;
      }
    }

    @layer components {
      .site-shell {
        @apply mx-auto w-full max-w-5xl px-5 sm:px-8;
      }

      .page-shell {
        @apply mx-auto flex w-full max-w-5xl flex-1 px-5 py-10 sm:px-8 sm:py-12;
      }

      .home-shell {
        @apply mx-auto flex min-h-0 w-full max-w-5xl flex-1 items-center px-5 py-5 sm:px-8 sm:py-8;
      }

      .display-title {
        @apply text-4xl leading-tight tracking-[-0.03em] text-[#20221f] sm:text-5xl;
        font-family: Georgia, "Times New Roman", serif;
      }

      .page-title {
        @apply text-3xl leading-tight tracking-[-0.02em] text-[#20221f];
        font-family: Georgia, "Times New Roman", serif;
      }

      .field-label {
        @apply mb-2 block text-sm font-medium text-[#40433f];
      }

      .text-field {
        @apply w-full rounded-md border border-[#d9d8d2] bg-white px-4 py-3 text-[15px] text-[#292b28] shadow-sm outline-none transition placeholder:text-[#9a9b96] focus:border-[#606060] focus:ring-2 focus:ring-black/10;
      }

      .primary-button {
        @apply inline-flex min-h-11 items-center justify-center rounded-md bg-[#292929] px-5 py-2.5 text-sm font-medium text-white transition hover:bg-black focus:outline-none focus:ring-2 focus:ring-black/20 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-40;
      }

      .secondary-button {
        @apply inline-flex min-h-10 items-center justify-center rounded-md border border-[#d9d8d2] bg-white px-4 py-2 text-sm font-medium text-[#40433f] transition hover:border-[#babbb5] hover:bg-[#f5f4f0] focus:outline-none focus:ring-2 focus:ring-black/15 disabled:cursor-not-allowed disabled:opacity-40;
      }

      .text-link {
        @apply text-[#333333] underline decoration-black/25 underline-offset-4 transition hover:decoration-black;
      }

      .location-link {
        @apply block w-full overflow-hidden text-ellipsis whitespace-nowrap border-0 bg-transparent px-4 py-3 text-left font-mono text-xs text-[#333333] transition hover:bg-[#f3f3f1] sm:text-sm;
      }

      .page-content {
        @apply block w-full overflow-x-auto whitespace-pre font-mono text-[11px] leading-[1.55] text-[#252724] sm:w-fit sm:text-xs;
        margin: 0 auto;
      }
    }

    mark {
      @apply rounded-sm bg-[#e5dfb8] px-0.5 text-[#292b28];
    }
  </style>
</head>
{{ end }}
