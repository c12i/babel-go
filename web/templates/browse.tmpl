<!doctype html>
<html lang="en">
  {{ template "head" . }}
  <body class="flex min-h-screen flex-col">
    {{ template "header" . }}

    <main class="page-shell">
      {{ if not .location }}
      <div class="mx-auto w-full max-w-2xl self-center">
        <h1 class="page-title">Browse by location</h1>
        <p class="mt-3 text-base leading-7 text-[#777974]">
          Open a page using its five-part library address.
        </p>

        <form action="/browse" method="POST" class="mt-8">
          {{ if .error }}{{ template "errorAlert" . }}{{ end }}
          <label for="location" class="field-label">Library address</label>
          <input
            type="text"
            name="location"
            id="location"
            placeholder="3a7f.2.1.15.204"
            class="text-field font-mono text-sm"
            aria-describedby="location-help"
            autofocus
          />
          <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <p id="location-help" class="text-sm text-[#858782]">Hexagon . wall . shelf . book . page</p>
            <button type="submit" class="primary-button">Open page</button>
          </div>
        </form>
      </div>
      {{ end }}

      {{ if .location }}
      <div class="mx-auto w-full max-w-5xl">
        <section class="mb-7">
          <div class="flex items-start justify-between gap-4">
            <div class="min-w-0">
              <p class="mb-1 text-sm text-[#777974]">Library address</p>
              <h1
                id="locationText"
                class="truncate font-mono text-sm text-[#292b28] sm:text-base"
                title="{{ .location.String }}"
              >{{ .location.String }}</h1>
            </div>
            <button onclick="copyLocation()" id="copyBtn" class="secondary-button min-h-9 shrink-0 px-3 py-1.5">
              Copy
            </button>
          </div>

          <dl class="mt-5 grid grid-cols-2 gap-x-6 gap-y-4 border-t border-[#e2e0da] pt-5 text-sm sm:grid-cols-5">
            <div class="min-w-0">
              <dt class="text-[#858782]">Hexagon</dt>
              <dd class="mt-1 truncate font-mono text-xs" title="{{ .location.Hexagon }}">{{ .location.Hexagon }}</dd>
            </div>
            <div><dt class="text-[#858782]">Wall</dt><dd class="mt-1">{{ .location.Wall }}</dd></div>
            <div><dt class="text-[#858782]">Shelf</dt><dd class="mt-1">{{ .location.Shelf }}</dd></div>
            <div><dt class="text-[#858782]">Book</dt><dd class="mt-1">{{ .location.Book }}</dd></div>
            <div><dt class="text-[#858782]">Page</dt><dd class="mt-1">{{ .location.Page }}</dd></div>
          </dl>
        </section>

        <article class="relative rounded-md border border-[#deddd7] bg-white px-3 py-5 shadow-sm sm:px-6 sm:py-8">
          <form action="/browse" method="POST" class="absolute left-2 top-1/2 z-10 -translate-y-1/2 sm:left-4">
            <input type="hidden" name="location" value="{{ .prevLocation.String }}" />
            <button
              type="submit"
              class="flex h-9 w-9 items-center justify-center rounded-full border border-[#d9d8d2] bg-transparent text-lg text-[#656762] transition hover:border-[#aeb0aa] hover:bg-[#faf9f6] hover:text-[#292b28] focus:outline-none focus:ring-2 focus:ring-black/15"
              aria-label="Previous page"
              title="Previous page"
            >&larr;</button>
          </form>

          <form action="/browse" method="POST" class="absolute right-2 top-1/2 z-10 -translate-y-1/2 sm:right-4">
            <input type="hidden" name="location" value="{{ .nextLocation.String }}" />
            <button
              type="submit"
              class="flex h-9 w-9 items-center justify-center rounded-full border border-[#d9d8d2] bg-transparent text-lg text-[#656762] transition hover:border-[#aeb0aa] hover:bg-[#faf9f6] hover:text-[#292b28] focus:outline-none focus:ring-2 focus:ring-black/15"
              aria-label="Next page"
              title="Next page"
            >&rarr;</button>
          </form>

          <p class="mb-5 text-center font-serif text-lg text-[#52544f]">Page {{ .location.Page }}</p>
          <pre class="page-content">{{ .displayContent }}</pre>
        </article>

        <nav aria-label="Go to page" class="mt-6 flex items-center justify-center">
          <form action="/browse" method="POST" class="flex items-center gap-2">
            <label for="pageInput" class="text-sm text-[#777974]">Page</label>
            <input
              type="number"
              id="pageInput"
              name="page"
              min="1"
              max="410"
              placeholder="{{ .location.Page }}"
              class="text-field w-16 px-2 py-2 text-center text-sm"
            />
            <span class="text-sm text-[#777974]">of 410</span>
            <input type="hidden" name="hexagon" value="{{ .location.Hexagon }}" />
            <input type="hidden" name="wall" value="{{ .location.Wall }}" />
            <input type="hidden" name="shelf" value="{{ .location.Shelf }}" />
            <input type="hidden" name="book" value="{{ .location.Book }}" />
            <button type="submit" class="secondary-button px-3">Go</button>
          </form>
        </nav>

        <div class="mt-10 border-t border-[#e2e0da] pt-6 text-center text-sm">
          <a href="/" class="text-link">Search for another passage</a>
        </div>
      </div>
      {{ end }}
    </main>

    {{ template "footer" . }}

    <script>
      function copyLocation() {
        const locationText = document.getElementById("locationText").textContent.trim();
        const copyBtn = document.getElementById("copyBtn");

        navigator.clipboard.writeText(locationText).then(() => {
          copyBtn.textContent = "Copied";
          setTimeout(() => {
            copyBtn.textContent = "Copy";
          }, 1600);
        }).catch(() => {
          copyBtn.textContent = "Could not copy";
          setTimeout(() => {
            copyBtn.textContent = "Copy";
          }, 1600);
        });
      }
    </script>
  </body>
</html>
